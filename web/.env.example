# Firebase-Config der Web-App (Projekteinstellungen -> Meine Apps -> Web).
# Diese Werte sind oeffentlich und landen im Browser-Bundle – das ist so
# vorgesehen. Geschuetzt wird ausschliesslich ueber die Security Rules.
# Den API-Key trotzdem in der Google Cloud Console auf die eigenen Domains
# beschraenken, damit er nicht fuer fremde Projekte missbraucht wird.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=dotlist-83d5c.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=dotlist-83d5c
PUBLIC_FIREBASE_STORAGE_BUCKET=dotlist-83d5c.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
